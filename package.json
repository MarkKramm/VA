{
  "name": "va-learning-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A learning platform that takes a learner from complete beginner to job-ready Virtual Assistant.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:arch": "vitest run src/domain/__tests__/boundaries.test.ts",
    "content:check": "vite-node scripts/validate-content.ts",
    "check": "npm run lint && npm run typecheck && npm run content:check && npm run test && npm run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
